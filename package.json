{
  "name": "@linktogo/ai-sync",
  "version": "0.1.0",
  "description": "Sync AI agent skills, practices, and workflows across repositories — author once, render for Claude Code, GitHub Copilot, Cursor, and Windsurf.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linktogo/ai-sync.git"
  },
  "homepage": "https://github.com/linktogo/ai-sync#readme",
  "bugs": {
    "url": "https://github.com/linktogo/ai-sync/issues"
  },
  "keywords": [
    "ai-sync",
    "ai-agents",
    "claude-code",
    "github-copilot",
    "cursor",
    "windsurf",
    "monorepo",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "apps/sync/bin",
    "apps/sync/src",
    "apps/workspace/bin",
    "apps/workspace/src",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "ai-sync": "apps/sync/bin/sync.js",
    "ai-workspace": "apps/workspace/bin/workspace.js"
  },
  "dependencies": {
    "@linktogo/ai-config": "^0.1.0",
    "@linktogo/ai-skill-sync": "^0.1.0",
    "@linktogo/ai-workspace-bootstrap": "^0.1.0",
    "@inquirer/prompts": "^7.2.0"
  },
  "scripts": {
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:scripts": "node --test scripts/*.test.js",
    "build": "nx run-many -t build",
    "start": "nx run board:start",
    "sync": "node apps/sync/bin/sync.js",
    "wk": "node apps/workspace/bin/workspace.js --config repos.example.json --workspace wk",
    "board:build": "nx run board:build",
    "test:board": "nx run board:test",
    "publish:libs": "npm publish --workspaces",
    "publish:verdaccio": "npm publish --workspaces --registry http://localhost:4873"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "^23.1.1",
    "@nx/eslint-plugin": "^23.1.1",
    "@nx/js": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/vue": "^23.1.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "nx": "^23.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "~4.1.10"
  }
}
