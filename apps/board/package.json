{
  "name": "@ai-sync/board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@linktogo/ai-config": "^0.1.0",
    "@linktogo/ai-workspace-bootstrap": "^0.1.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "nx": {
    "tags": [
      "scope:board",
      "type:app"
    ],
    "targets": {
      "start": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/board/server.js"
        }
      },
      "test-server": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --test apps/board/server.test.js"
        }
      },
      "test": {
        "dependsOn": [
          "test-server"
        ]
      }
    }
  }
}
